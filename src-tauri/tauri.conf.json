{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ondes",
  "version": "1.0.0",
  "identifier": "fr.ondes.diagnostic",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ondes — diagnostic du réseau",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://speed.cloudflare.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Diagnostic du réseau domestique Freebox",
    "longDescription": "Ondes se connecte à ta Freebox pour mesurer le débit, suivre chaque appareil, analyser le Wi-Fi et les interférences.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "languages": ["French"], "installMode": "currentUser" },
      "wix": { "language": "fr-FR" }
    }
  }
}
